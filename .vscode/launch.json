            "preLaunchTask": "Build Debug x64"
        },
        {
            "name": "Run Release (x64)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}\\x64\\Release\\Voyager-2.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "integratedTerminal",
            "preLaunchTask": "Build Release x64"
        }
    ]
}
